{
  "name": "sugarcommerce/zip-stream",
  "version": "1.1.0",
  "description": "Write a ZIP straight to the client without building it first. Members are streamed through, so a 40 GB archive costs a buffer rather than disk, and ZIP64 turns on by itself when the numbers need it.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/zip-stream",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["zip", "stream", "download", "archive", "zip64"],
  "require": { "php": ">=8.5" },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\ZipStream\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\ZipStream\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/zip-stream/issues", "source": "https://github.com/sugarcommerce/zip-stream" }
}
